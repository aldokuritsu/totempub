---
import { clusters, normalizePath, type ClusterKey } from '../data/navigation';

interface Props {
    cluster: ClusterKey;
}

const { cluster } = Astro.props;
const { sidebarTitle, links } = clusters[cluster];
const currentPath = normalizePath(Astro.url.pathname);
---

<div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 shadow-xs sticky top-24">
    <h3 class="text-xl font-bold text-brand-dark mb-6 pb-2 border-b-2 border-brand w-fit">{sidebarTitle}</h3>
    <ul class="space-y-1">
        {links.map((link) => {
            const active = currentPath === link.url;
            return (
                <li>
                    <a
                        href={link.url}
                        aria-current={active ? 'page' : undefined}
                        class:list={[
                            'block py-2 px-4 rounded transition-colors sidebar-link',
                            active
                                ? 'font-bold text-brand bg-brand-light'
                                : 'hover:bg-brand-light hover:text-brand',
                        ]}
                    >
                        {link.name}
                    </a>
                </li>
            );
        })}
    </ul>

    <div class="mt-10 p-4 bg-brand rounded-xl text-white">
        <h4 class="font-bold mb-2">Besoin d'un devis ?</h4>
        <p class="text-sm mb-4 opacity-90">Nos experts vous répondent sous 24h pour votre projet de totem.</p>
        <a href="/contact/"
            class="block text-center bg-white text-brand py-2 rounded-lg font-bold hover:bg-brand-light transition-colors">Demander
            un prix</a>
    </div>
</div>
