---
import type { BreadcrumbItem } from '../data/navigation';

interface Props {
    items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="flex mb-8 text-sm text-gray-500" aria-label="Breadcrumb">
    <ol class="flex list-none p-0">
        {items.map((item, index) => (
            <li class="flex items-center">
                {item.href ? (
                    <a href={item.href} class="hover:text-brand">{item.name}</a>
                ) : (
                    <span class="text-brand font-medium" aria-current="page">{item.name}</span>
                )}
                {index < items.length - 1 && (
                    <svg class="w-3 h-3 mx-2" fill="currentColor" viewBox="0 0 20 20">
                        <path
                            d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z">
                        </path>
                    </svg>
                )}
            </li>
        ))}
    </ol>
</nav>
