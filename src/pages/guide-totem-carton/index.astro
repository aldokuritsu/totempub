---
import ClusterLayout from '../../layouts/ClusterLayout.astro';
import type { BreadcrumbItem } from '../../data/navigation';

const title = 'Guide Complet du Totem en Carton : Conseils, Astuces et Comparatifs';
const description =
    'Tout savoir sur le totem carton PLV : comment le choisir, le fabriquer, le comparer aux autres PLV et réussir votre campagne. Guide expert gratuit.';
const breadcrumb: BreadcrumbItem[] = [
    { name: 'Accueil', href: '/' },
    { name: 'Guides & Ressources' },
];
---

<ClusterLayout title={title} description={description} cluster="guide-totem-carton" breadcrumb={breadcrumb}>
    <h1 class="text-4xl md:text-5xl font-extrabold text-brand-dark mb-6 leading-tight">Le guide complet du
        totem en carton publicitaire</h1>

    <p class="text-xl text-gray-600 mb-10 leading-relaxed">
        Maximisez l'efficacité de vos campagnes PLV grâce aux conseils de nos experts. Techniques,
        stratégies et bonnes pratiques réunies.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        <a href="/guide-totem-carton/choisir-totem-carton/"
            class="group block bg-gray-50 rounded-2xl p-8 hover:bg-brand hover:text-white transition-all">
            <span
                class="inline-block py-1 px-3 bg-brand/10 group-hover:bg-white/20 text-brand group-hover:text-white rounded-full text-xs font-bold mb-4 uppercase">Guide
                Décisionnel</span>
            <h3 class="text-2xl font-bold mb-3">Comment bien choisir son totem ?</h3>
            <p class="opacity-80 text-sm mb-6 leading-relaxed">Arbre de décision selon l'espace, l'usage et
                le budget.</p>
            <span class="font-bold flex items-center text-sm">Lire le guide <svg
                    class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none"
                    stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7">
                    </path>
                </svg></span>
        </a>

        <a href="/guide-totem-carton/faire-totem-carton/"
            class="group block bg-gray-50 rounded-2xl p-8 hover:bg-brand hover:text-white transition-all">
            <span
                class="inline-block py-1 px-3 bg-brand/10 group-hover:bg-white/20 text-brand group-hover:text-white rounded-full text-xs font-bold mb-4 uppercase">Tutoriel</span>
            <h3 class="text-2xl font-bold mb-3">Comment monter son totem ?</h3>
            <p class="opacity-80 text-sm mb-6 leading-relaxed">Guide illustré et astuces pour une stabilité
                parfaite.</p>
            <span class="font-bold flex items-center text-sm">Lire le guide <svg
                    class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none"
                    stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7">
                    </path>
                </svg></span>
        </a>
    </div>
</ClusterLayout>
