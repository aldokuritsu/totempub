---
import ClusterLayout from '../../layouts/ClusterLayout.astro';
import type { BreadcrumbItem } from '../../data/navigation';

const title = 'Les Types de Carton pour Totems PLV : Guide des Matériaux | Kontfeel';
const description =
    'Micro-cannelure, double cannelure, carton alvéolaire : apprenez à choisir le bon carton pour votre totem publicitaire selon sa taille et son usage.';
const breadcrumb: BreadcrumbItem[] = [
    { name: 'Accueil', href: '/' },
    { name: 'Fabrication & Perso', href: '/fabrication-totem-carton/' },
    { name: 'Matériaux Carton' },
];
---

<ClusterLayout title={title} description={description} cluster="fabrication-totem-carton" breadcrumb={breadcrumb}>
    <h1 class="text-4xl md:text-5xl font-extrabold text-brand-dark mb-6 leading-tight">Choisir le bon
        matériau : l'ingénierie carton au service de votre PLV</h1>

    <div class="prose prose-lg prose-brand max-w-none text-gray-700">
        <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            Le terme "carton" cache une grande variété de structures techniques. Le choix du matériau dépend
            de la durée de vie souhaitée, de la taille du totem et des contraintes du point de vente.
        </p>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">La Micro-cannelure (Type E / F)</h2>
        <p class="mb-6">
            C'est la star de la PLV de comptoir et des totems elliptiques. Fine, légère mais rigide, elle
            offre une surface d'impression très lisse. C'est le matériau idéal pour un rendu "qualité photo"
            sans voir les ondulations du carton.
        </p>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">Le Carton Double Cannelure (Type BC / EB)</h2>
        <p class="mb-6">
            Plus épais et beaucoup plus robuste, il est utilisé pour les totems de grande taille ou ceux
            devant supporter du poids (étagères, distributeurs de flyers). Il résiste mieux aux chocs et aux
            manipulations répétées en magasin.
        </p>

        <div
            class="my-12 bg-blue-50 rounded-3xl p-8 flex flex-col md:flex-row gap-8 items-center border border-blue-100">
            <div class="md:w-1/2">
                <h3 class="text-2xl font-bold text-brand-dark mb-4">Le Carton Alvéolaire (Nid d'abeille)
                </h3>
                <p class="mb-4">Le summum de la rigidité pour des PLV d'exception ou du mobilier de stand.
                </p>
                <ul class="space-y-4">
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Indéformable</strong> : Ne se courbe pas, même sur de très grandes
                            surfaces planes.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Look Premium</strong> : Tranches visibles design ou cachées par des
                            profilés.</span>
                    </li>
                </ul>
            </div>
            <div
                class="md:w-1/2 aspect-square bg-white rounded-2xl flex items-center justify-center p-8 shadow-xs">
                <svg class="w-24 h-24 text-blue-400 opacity-60" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2L4.5 20.29l.71.71L12 18l6.79 3 .71-.71z"></path>
                </svg>
            </div>
        </div>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">Carton blanc ou carton brun (Kraft) ?</h2>
        <p class="mb-6">
            Le <strong>carton blanc</strong> est le choix standard pour une impression quadrichromie fidèle.
            Le <strong>carton brun (kraft)</strong> est de plus en plus plébiscité pour son aspect
            "authentique", "éco-conçu" et "naturel". L'impression d'un blanc de soutien permet de conserver
            des couleurs vives même sur support brun.
        </p>

        <div class="bg-gray-100 p-8 rounded-3xl mb-8">
            <p class="text-gray-800 font-bold mb-4">🧪 Tests de stabilité :</p>
            <p class="text-gray-600 text-sm">Chez Kontfeel, nous testons la résistance de chaque structure.
                Si votre totem doit être placé près d'une entrée avec des courants d'air, nous vous
                orienterons vers un matériau plus dense avec un pied lesté.</p>
        </div>
    </div>

    <!-- Horizontal links -->
    <div
        class="mt-16 pt-8 border-t border-gray-100 flex justify-between items-center text-sm font-bold text-brand">
        <a href="/fabrication-totem-carton/impression-techniques/" class="flex items-center hover:underline">←
            Précédent : Techniques d'Impression</a>
        <a href="/fabrication-totem-carton/eco-responsable/" class="flex items-center hover:underline">Suivant : Éco-responsable
            →</a>
    </div>
</ClusterLayout>
