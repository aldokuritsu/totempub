---
import ClusterLayout from '../../layouts/ClusterLayout.astro';
import type { BreadcrumbItem } from '../../data/navigation';

const title = 'Prix & Devis Totem en Carton : Estimation & Tarification | Kontfeel';
const description =
    'Comprendre le prix d\'un totem en carton : facteurs de coût, tarifs dégressifs et demande de devis express. Obtenez une estimation personnalisée sous 24h.';
const breadcrumb: BreadcrumbItem[] = [
    { name: 'Accueil', href: '/' },
    { name: 'Fabrication & Perso', href: '/fabrication-totem-carton/' },
    { name: 'Prix & Devis' },
];
---

<ClusterLayout title={title} description={description} cluster="fabrication-totem-carton" breadcrumb={breadcrumb}>
    <h1 class="text-4xl md:text-5xl font-extrabold text-brand-dark mb-6 leading-tight">Prix des totems en
        carton : transparence et réactivité</h1>

    <div class="prose prose-lg prose-brand max-w-none text-gray-700">
        <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            Chaque projet de PLV est unique, et son prix l'est tout autant. Cependant, certains facteurs
            clés influencent systématiquement le coût final de votre commande.
        </p>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">Qu'est-ce qui détermine le prix ?</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
            <div class="p-6 bg-white border border-gray-100 rounded-2xl shadow-xs">
                <h4 class="font-bold text-brand mb-2">La quantité</h4>
                <p class="text-sm">C'est le facteur numéro 1. Les frais de calage machine et de préparation
                    sont amortis sur le nombre de pièces. Plus vous commandez, plus le prix unitaire baisse
                    drastiquement.</p>
            </div>
            <div class="p-6 bg-white border border-gray-100 rounded-2xl shadow-xs">
                <h4 class="font-bold text-brand mb-2">Le format et la forme</h4>
                <p class="text-sm">Un totem standard 160x50cm coûte moins cher qu'une silhouette complexe
                    découpée à la forme nécessitant une création de tracé spécifique.</p>
            </div>
            <div class="p-6 bg-white border border-gray-100 rounded-2xl shadow-xs">
                <h4 class="font-bold text-brand mb-2">La technique d'impression</h4>
                <p class="text-sm">Le numérique est avantageux pour les petites séries (1 à 100). L'offset
                    devient imbattable pour les volumes industriels (plus de 500 unités).</p>
            </div>
            <div class="p-6 bg-white border border-gray-100 rounded-2xl shadow-xs">
                <h4 class="font-bold text-brand mb-2">Les options et finitions</h4>
                <p class="text-sm">L'ajout de porte-flyers, d'un pelliculage mat ou d'un système de
                    déploiement automatique influence le coût de fabrication.</p>
            </div>
        </div>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">Estimation indicative</h2>
        <p class="mb-6">
            À titre purement informatif, voici des fourchettes de prix généralement constatées (HT pièce) :
        </p>
        <ul class="list-disc pl-6 mb-8 space-y-2">
            <li><strong>Petite série (10-50 ex)</strong> : de 35€ à 75€ selon complexité.</li>
            <li><strong>Moyenne série (100-300 ex)</strong> : de 15€ à 30€.</li>
            <li><strong>Grande série (> 1000 ex)</strong> : de 5€ à 12€.</li>
        </ul>

        <div class="bg-brand-light p-8 rounded-3xl mb-12 border border-brand/10">
            <h4 class="text-xl font-bold mb-4 text-brand">Obtenez votre devis personnalisé en 24h</h4>
            <p class="mb-6 opacity-90">Pour être précis, notre équipe a besoin de connaître vos dimensions,
                la quantité souhaitée et vos éventuelles contraintes de livraison.</p>
            <a href="/contact/"
                class="inline-block bg-brand hover:bg-red-700 text-white px-8 py-3 rounded-full font-bold transition-all shadow-lg hover:-translate-y-1">Demander
                mon étude gratuite</a>
        </div>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">Nos engagements tarifaires</h2>
        <p class="mb-6">
            Chez Kontfeel, nous pratiquons des prix "Direct Fabricant". En supprimant les intermédiaires,
            nous vous garantissons le meilleur rapport qualité/prix du marché. De plus, nos devis sont
            détaillés : vous comprenez exactement ce que vous payez, de la création graphique à la livraison
            finale.
        </p>
    </div>

    <!-- Horizontal links -->
    <div
        class="mt-16 pt-8 border-t border-gray-100 flex justify-between items-center text-sm font-bold text-brand">
        <a href="/fabrication-totem-carton/eco-responsable/" class="flex items-center hover:underline">←
            Précédent : Éco-responsable</a>
        <a href="/fabrication-totem-carton/personnalisation/" class="flex items-center hover:underline">Suivant : Personnalisation
            →</a>
    </div>
</ClusterLayout>
