---
import ClusterLayout from '../../layouts/ClusterLayout.astro';
import type { BreadcrumbItem } from '../../data/navigation';

const title = 'Totem Carton pour Commerce & Boutique : PLV de Proximité | Kontfeel';
const description =
    'Dynamisez votre boutique ou commerce avec nos totems en carton sur-mesure. Signalétique, décoration de vitrine et PLV promotionnelle élégante et modulable.';
const breadcrumb: BreadcrumbItem[] = [
    { name: 'Accueil', href: '/' },
    { name: 'Secteurs & Usages', href: '/totem-carton-secteurs/' },
    { name: 'Commerce & Boutique' },
];
---

<ClusterLayout title={title} description={description} cluster="totem-carton-secteurs" breadcrumb={breadcrumb}>
    <h1 class="text-4xl md:text-5xl font-extrabold text-brand-dark mb-6 leading-tight">Commerces de
        proximité :
        théâtralisée votre vitrine et votre intérieur</h1>

    <div class="prose prose-lg prose-brand max-w-none text-gray-700">
        <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            Pour un indépendant ou une franchise, l'image de marque passe par une décoration soignée. Le
            totem en carton en boutique offre une solution flexible et esthétique pour animer vos points de
            vente.
        </p>

        <div
            class="my-12 bg-accent/10 rounded-3xl p-8 flex flex-col md:flex-row gap-8 items-center border border-accent/20 shadow-inner">
            <div class="md:w-1/2">
                <h3 class="text-2xl font-bold text-brand-dark mb-4">Pourquoi la boutique aime le carton ?
                </h3>
                <ul class="space-y-4">
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Élégance Visuelle</strong> : Finition haut de gamme (vernis, textures)
                            qui valorise vos produits sans "faire cheap".</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Modularité</strong> : Changez de décoration selon les saisons (Soldes,
                            Noël, Printemps) à moindre coût.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Gain d'espace</strong> : Totems fins qui ne gênent pas la circulation
                            des clients entre vos portants.</span>
                    </li>
                </ul>
            </div>
            <div class="md:w-1/2 aspect-video bg-gray-100 rounded-2xl flex items-center justify-center p-8">
                <svg class="w-20 h-20 text-accent opacity-60" fill="currentColor" viewBox="0 0 24 24">
                    <path
                        d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zM6 10h2v2H6v-2zm0 4h2v2H6v-2zm10-4h2v2h-2v-2zm0 4h2v2h-2v-2zm-5-4h2v2h-2v-2zm0 4h2v2h-2v-2z">
                    </path>
                </svg>
            </div>
        </div>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">La vitrine, premier contact client</h2>
        <p class="mb-6">
            Une vitrine attractive augmente le taux de passage en boutique de plus de 20%. Utilisez nos
            totems pour créer des jeux de hauteur et des profondeurs de champ dans votre vitrine. Faciles à
            installer par vos équipes de vente, nos supports en carton vous permettent de renouveler votre
            communication visuelle sans faire appel à un prestataire extérieur à chaque collection.
        </p>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">Inspirations pour votre boutique</h2>
        <ul class="list-disc pl-6 mb-8 space-y-2">
            <li><strong>Totem d'accueil</strong> : Pour souhaiter la bienvenue et annoncer les univers de
                votre magasin.</li>
            <li><strong>Chevalet de vitrine</strong> : Pour mettre en avant un produit phare ou une égérie.
            </li>
            <li><strong>Colonnes de balisage</strong> : Pour identifier les rayons (homme, femme, enfant,
                promotion).</li>
        </ul>

        <div class="bg-gray-50 p-8 rounded-3xl mb-8 border border-gray-100 text-center">
            <p class="text-gray-800 font-bold mb-4">Commandez vos totems en petites séries</p>
            <p class="text-gray-500 mb-6">Nous accompagnons les commerçants indépendants pour leurs besoins
                de PLV dès 10 unités.</p>
            <a href="/contact/" class="text-brand font-extrabold hover:underline">Accéder au formulaire
                →</a>
        </div>
    </div>

    <!-- Horizontal links -->
    <div
        class="mt-16 pt-8 border-t border-gray-100 flex justify-between items-center text-sm font-bold text-brand">
        <a href="/totem-carton-secteurs/salon-professionnel/" class="flex items-center hover:underline">←
            Précédent : Salon Professionnel</a>
        <a href="/totem-carton-secteurs/evenementiel/" class="flex items-center hover:underline">Suivant : Événementiel →</a>
    </div>
</ClusterLayout>
