---
import ClusterLayout from '../../layouts/ClusterLayout.astro';
import type { BreadcrumbItem } from '../../data/navigation';

const title = 'Totem Carton pour l\'Événementiel : PLV Éphémère & Impactante | Kontfeel';
const description =
    'Festivals, lancements de produits, soirées d\'entreprise : découvrez nos solutions de totems carton événementiels. PLV éphémère 100% personnalisable et recyclable.';
const breadcrumb: BreadcrumbItem[] = [
    { name: 'Accueil', href: '/' },
    { name: 'Secteurs & Usages', href: '/totem-carton-secteurs/' },
    { name: 'Événementiel' },
];
---

<ClusterLayout title={title} description={description} cluster="totem-carton-secteurs" breadcrumb={breadcrumb}>
    <h1 class="text-4xl md:text-5xl font-extrabold text-brand-dark mb-6 leading-tight">L'événementiel :
        le totem carton comme créateur d'univers éphémères</h1>

    <div class="prose prose-lg prose-brand max-w-none text-gray-700">
        <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            Un événement est par définition ponctuel. Le totem en carton est la réponse parfaite : un
            support impactant, léger, personnalisable à l'infini et facile à recycler après usage.
        </p>

        <div
            class="my-12 bg-gray-900 text-white rounded-3xl p-8 flex flex-col md:flex-row gap-8 items-center border border-gray-800 shadow-2xl">
            <div class="md:w-1/2">
                <h3 class="text-2xl font-bold mb-4">La PLV au service de l'événement</h3>
                <ul class="space-y-4">
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Réactivité Totale</strong> : Délais de fabrication courts pour vos
                            projets de dernière minute.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Scénographie Modulaire</strong> : Assemblez des totems pour créer des
                            murs d'images ou des parcours de déambulation.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Budget Maîtrisé</strong> : Un coût par contact imbattable pour des
                            actions de communication "one shot".</span>
                    </li>
                </ul>
            </div>
            <div
                class="md:w-1/2 aspect-square bg-white/10 rounded-2xl flex items-center justify-center p-8 backdrop-blur-xs border border-white/20">
                <svg class="w-24 h-24 text-brand opacity-80" fill="currentColor" viewBox="0 0 24 24">
                    <path
                        d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z">
                    </path>
                </svg>
            </div>
        </div>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">De la signalétique à la décoration</h2>
        <p class="mb-6">
            Lors d'une soirée de lancement, d'un festival ou d'un colloque professionnel, les besoins sont
            multiples. Nos totems servent à :
        </p>
        <ul class="list-disc pl-6 mb-8 space-y-2">
            <li><strong>Informer</strong> : Programme de la journée, plan du site, liste des intervenants.
            </li>
            <li><strong>Balisage</strong> : Fléchage vers les différentes zones (buffet, sanitaires,
                scènes).</li>
            <li><strong>Identité</strong> : Affichage géant de vos logos et des logos partenaires (Mur de
                logos).</li>
            <li><strong>Relais Réseaux Sociaux</strong> : Cadres photo géants ou totems "Selfie Spot".</li>
        </ul>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">Un engagement éco-responsable</h2>
        <p class="mb-6">
            L'événementiel est souvent critiqué pour ses déchets. Choisir le carton Kontfeel, c'est opter
            pour une solution bas carbone, certifiée FSC ou PEFC, dont vous savez qu'elle sera valorisée
            après l'événement grâce aux filières de recyclage de papier et carton déjà en place.
        </p>

        <div class="bg-brand-light p-8 rounded-3xl mb-12 text-center border-2 border-brand/20">
            <h4 class="text-2xl font-extrabold text-brand mb-4 leading-tight">Besoin d'un parc de totems
                pour un événement national ?</h4>
            <p class="text-brand-dark opacity-80 mb-8 max-w-xl mx-auto">Nous gérons la production
                centralisée et l'expédition éclatée sur tous vos sites en France et en Europe.</p>
            <a href="/contact/" class="btn-primary">Obtenez un devis logistique complexe</a>
        </div>
    </div>

    <!-- Horizontal links -->
    <div
        class="mt-16 pt-8 border-t border-gray-100 flex justify-between items-center text-sm font-bold text-brand">
        <a href="/totem-carton-secteurs/commerce-boutique/" class="flex items-center hover:underline">←
            Précédent : Commerce & Boutique</a>
        <a href="/totem-carton-secteurs/pharmacie/" class="flex items-center hover:underline">Suivant : Pharmacie →</a>
    </div>
</ClusterLayout>
