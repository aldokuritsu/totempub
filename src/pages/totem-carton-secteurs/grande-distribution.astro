---
import ClusterLayout from '../../layouts/ClusterLayout.astro';
import type { BreadcrumbItem } from '../../data/navigation';

const title = 'Totem Carton pour Grande Distribution (GMS) : PLV Massive | Kontfeel';
const description =
    'Boostez vos ventes en supermarché et hypermarché avec nos totems en carton GMS. Visibilité maximale en allée centrale, montage éclair et grande robustesse.';
const breadcrumb: BreadcrumbItem[] = [
    { name: 'Accueil', href: '/' },
    { name: 'Secteurs & Usages', href: '/totem-carton-secteurs/' },
    { name: 'Grande Distribution' },
];
---

<ClusterLayout title={title} description={description} cluster="totem-carton-secteurs" breadcrumb={breadcrumb}>
    <h1 class="text-4xl md:text-5xl font-extrabold text-brand-dark mb-6 leading-tight">GMS : la PLV carton
        pour
        émerger en linéaire</h1>

    <div class="prose prose-lg prose-brand max-w-none text-gray-700">
        <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            En hypermarché, le consommateur est sollicité par des milliers de références. Le totem en carton
            est l'outil indispensable pour briser la monotonie du linéaire et créer une "pause visuelle"
            engageante.
        </p>

        <div
            class="my-12 bg-red-50 rounded-3xl p-8 flex flex-col md:flex-row gap-8 items-center border border-red-100">
            <div class="md:w-1/2">
                <h3 class="text-2xl font-bold text-brand-dark mb-4">Critères d'exigence en GMS</h3>
                <ul class="space-y-4">
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Résistance aux chocs</strong> : Utilisation de cartons micro-cannelure
                            renforcés pour supporter les passages de chariots.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Simplicité de montage</strong> : Déploiement en quelques secondes par
                            les chefs de rayon ou merchandiseurs.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Logistique optimisée</strong> : Livrés à plat pour un déploiement
                            massif sur l'ensemble d'un parc de magasins.</span>
                    </li>
                </ul>
            </div>
            <div
                class="md:w-1/2 aspect-square bg-white rounded-2xl flex items-center justify-center p-8 shadow-xs">
                <svg class="w-24 h-24 text-red-500 opacity-60" fill="currentColor" viewBox="0 0 24 24">
                    <path
                        d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z">
                    </path>
                </svg>
            </div>
        </div>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">Théâtralisation et Allée Centrale</h2>
        <p class="mb-6">
            Lors de vos opérations "Temps Forts" (Rentrée des classes, fêtes de fin d'année, foire aux
            vins), le totem ne doit plus être isolé. Chez Kontfeel, nous concevons des ensembles de totems
            qui créent de véritables "univers" en magasin. Associés à des frontons et des meubles de sol,
            ils identifient clairement votre zone promotionnelle.
        </p>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">Nos best-sellers pour la GMS</h2>
        <ul class="list-disc pl-6 mb-8 space-y-2">
            <li><strong>Le Totem Géant (200x80cm)</strong> : Pour une visibilité au-dessus de la ligne
                d'horizon des rayons.</li>
            <li><strong>Le Totem Elliptique Standard</strong> : Polyvalent et économique pour les opérations
                courantes.</li>
            <li><strong>La Tour Cube Empilée</strong> : Parfaite pour le balisage de tête de gondole.</li>
        </ul>

        <div class="bg-gray-900 text-white p-8 rounded-3xl mb-8">
            <h4 class="text-xl font-bold mb-4 text-brand">Prêt pour votre prochain lancement GMS ?</h4>
            <p class="mb-6 opacity-80 text-lg">Nous gérons les expéditions multi-sites directement vers vos
                entrepôts ou points de vente.</p>
            <a href="/contact/" class="btn-primary">Parlons de votre logistique</a>
        </div>
    </div>

    <!-- Horizontal links -->
    <div
        class="mt-16 pt-8 border-t border-gray-100 flex justify-between items-center text-sm font-bold text-brand">
        <a href="/totem-carton-secteurs/pharmacie/" class="flex items-center hover:underline">←
            Précédent : Pharmacie</a>
        <a href="/totem-carton-secteurs/salon-professionnel/" class="flex items-center hover:underline">Suivant : Salon
            Professionnel →</a>
    </div>
</ClusterLayout>
