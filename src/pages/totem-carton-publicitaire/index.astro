---
import ClusterLayout from '../../layouts/ClusterLayout.astro';
import type { BreadcrumbItem } from '../../data/navigation';

const title = 'Types de Totems en Carton Publicitaire : Toutes les Formes PLV';
const description =
    'Elliptique, 3 faces, pliable, cube, 3D, comptoir : découvrez toutes les formes de totems carton PLV et trouvez celle qui correspond à votre besoin.';
const breadcrumb: BreadcrumbItem[] = [
    { name: 'Accueil', href: '/' },
    { name: 'Formes & Types' },
];
---

<ClusterLayout title={title} description={description} cluster="totem-carton-publicitaire" breadcrumb={breadcrumb}>
    <h1 class="text-4xl md:text-5xl font-extrabold text-brand-dark mb-6 leading-tight">Les différents types
        de totems en carton publicitaire</h1>

    <p class="text-xl text-gray-600 mb-10 leading-relaxed">
        Le choix de la forme de votre totem dépend de votre espace, de votre message et de l'impact
        souhaité. Découvrez notre gamme complète de supports PLV carton.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        <!-- A1: Elliptique -->
        <div
            class="bg-white rounded-2xl border border-gray-100 shadow-xs overflow-hidden group hover:shadow-md transition-all">
            <div class="aspect-video bg-gray-100 flex items-center justify-center p-8">
                <svg class="w-16 h-16 text-gray-300 group-hover:text-brand transition-colors"
                    fill="currentColor" viewBox="0 0 24 24">
                    <path
                        d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z">
                    </path>
                </svg>
            </div>
            <div class="p-6">
                <h3 class="text-xl font-bold text-brand-dark mb-2">Totem Elliptique</h3>
                <p class="text-gray-500 text-sm mb-4">Le classique incontournable. Double face, élégant et
                    peu encombrant. Idéal pour les allées.</p>
                <a href="/totem-carton-publicitaire/totem-elliptique/" class="text-brand font-bold inline-flex items-center">Voir le
                    produit <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9 5l7 7-7 7"></path>
                    </svg></a>
            </div>
        </div>

        <!-- A2: 3 Faces -->
        <div
            class="bg-white rounded-2xl border border-gray-100 shadow-xs overflow-hidden group hover:shadow-md transition-all">
            <div class="aspect-video bg-gray-100 flex items-center justify-center p-8">
                <svg class="w-16 h-16 text-gray-300 group-hover:text-brand transition-colors"
                    fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2L1 21h22L12 2zm0 4.14l7.63 12.86H4.37L12 6.14z"></path>
                </svg>
            </div>
            <div class="p-6">
                <h3 class="text-xl font-bold text-brand-dark mb-2">Totem 3 Faces</h3>
                <p class="text-gray-500 text-sm mb-4">Visibilité à 360°. Robuste et percutant, parfait pour
                    le centre des magasins ou les salons.</p>
                <a href="/totem-carton-publicitaire/totem-3-faces/" class="text-brand font-bold inline-flex items-center">Voir le
                    produit <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9 5l7 7-7 7"></path>
                    </svg></a>
            </div>
        </div>

        <!-- A3: Pliable -->
        <div
            class="bg-white rounded-2xl border border-gray-100 shadow-xs overflow-hidden group hover:shadow-md transition-all">
            <div class="aspect-video bg-gray-100 flex items-center justify-center p-8">
                <svg class="w-16 h-16 text-gray-300 group-hover:text-brand transition-colors"
                    fill="currentColor" viewBox="0 0 24 24">
                    <path
                        d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zM6 10h2v2H6v-2zm0 4h2v2H6v-2zm10-4h2v2h-2v-2zm0 4h2v2h-2v-2zm-5-4h2v2h-2v-2zm0 4h2v2h-2v-2z">
                    </path>
                </svg>
            </div>
            <div class="p-6">
                <h3 class="text-xl font-bold text-brand-dark mb-2">Totem Pliable</h3>
                <p class="text-gray-500 text-sm mb-4">La solution nomade. Se transporte à plat et se monte
                    en un clin d'œil. Idéal pour les événements.</p>
                <a href="/totem-carton-publicitaire/totem-pliable/" class="text-brand font-bold inline-flex items-center">Voir le
                    produit <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9 5l7 7-7 7"></path>
                    </svg></a>
            </div>
        </div>

        <!-- More cards here... -->
    </div>

    <div class="prose prose-brand max-w-none">
        <h2 class="text-2xl font-bold text-brand-dark mb-6">Comment bien choisir sa forme de totem ?</h2>
        <p class="mb-4">
            Toutes nos formes peuvent être personnalisées avec des accessoires comme des porte-flyers, des
            urnes ou des écrans LCD. Consultez notre guide complet sur <a
                href="/guide-totem-carton/choisir-totem-carton/">comment choisir son totem</a>.
        </p>
    </div>
</ClusterLayout>
