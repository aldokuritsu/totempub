---
import ClusterLayout from '../../layouts/ClusterLayout.astro';
import type { BreadcrumbItem } from '../../data/navigation';

const title = 'Totem Elliptique en Carton : Le Classique de la PLV | Kontfeel';
const description =
    'Le totem elliptique en carton est le support PLV le plus populaire. Double face, élégant et facile à monter. Personnalisation sur-mesure et prix direct fabricant.';
const breadcrumb: BreadcrumbItem[] = [
    { name: 'Accueil', href: '/' },
    { name: 'Formes & Types', href: '/totem-carton-publicitaire/' },
    { name: 'Totem Elliptique' },
];
---

<ClusterLayout title={title} description={description} cluster="totem-carton-publicitaire" breadcrumb={breadcrumb}>
    <h1 class="text-4xl md:text-5xl font-extrabold text-brand-dark mb-6 leading-tight">Totem elliptique :
        l'élégance et la simplicité pour votre communication</h1>

    <div class="prose prose-lg prose-brand max-w-none text-gray-700">
        <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            Le totem elliptique (ou totem galbé) est le grand classique de la PLV en carton. Sa silhouette
            courbe offre une lecture double face optimale tout en occupant un minimum d'espace au sol.
        </p>

        <div
            class="my-12 bg-gray-50 rounded-3xl p-8 flex flex-col md:flex-row gap-8 items-center border border-gray-100 shadow-inner">
            <div class="md:w-1/2">
                <h3 class="text-2xl font-bold text-brand-dark mb-4">Les points forts du totem galbé</h3>
                <ul class="space-y-4">
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Double Visibilité</strong> : Impact identique des deux côtés pour
                            capter les flux de circulation.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Montage automatique</strong> : Système d'élastiques internes pour un
                            déploiement instantané.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Faible encombrement</strong> : Profondeur réduite, idéal pour les
                            points de vente exigus.</span>
                    </li>
                </ul>
            </div>
            <div
                class="md:w-1/2 aspect-[3/4] bg-gray-200 rounded-2xl flex items-center justify-center p-12">
                <svg class="w-24 h-24 text-gray-400 opacity-50" fill="currentColor" viewBox="0 0 24 24">
                    <path
                        d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z">
                    </path>
                </svg>
            </div>
        </div>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">Utilisation recommandée</h2>
        <p class="mb-6">
            Indémodable, le totem elliptique s'installe partout : entrées de magasins, couloirs de centres
            commerciaux, accueils d'entreprises ou foires expo. C'est l'outil parfait pour une campagne
            promotionnelle de masse grâce à son coût de revient attractif et sa facilité de mise en place
            par les équipes de vente.
        </p>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">Options de personnalisation</h2>
        <p class="mb-6">
            Au-delà de l'impression, vous pouvez équiper votre totem galbé de nombreux accessoires :
        </p>
        <ul class="list-disc pl-6 mb-8 space-y-2">
            <li><strong>Porte-flyers</strong> : En carton ou PVC cristal.</li>
            <li><strong>Découpe à la forme</strong> : Fronton découpé pour souligner un produit.</li>
            <li><strong>Pelliculage</strong> : Mat ou brillant pour une finition haut de gamme.</li>
        </ul>

        <div class="bg-gray-900 text-white p-8 rounded-3xl mb-12">
            <h4 class="text-xl font-bold mb-4 text-brand">Besoin d'un format spécifique ?</h4>
            <p class="mb-6 opacity-80">Nous fabriquons vos totems elliptiques sur-mesure : du petit format
                de comptoir (40cm) au totem géant (240cm).</p>
            <a href="/fabrication-totem-carton/prix-devis/"
                class="inline-block bg-brand hover:bg-red-700 text-white px-8 py-3 rounded-full font-bold transition-all underline decoration-brand-light">Demander
                un prix</a>
        </div>
    </div>

    <!-- Horizontal links -->
    <div
        class="mt-16 pt-8 border-t border-gray-100 flex justify-between items-center text-sm font-bold text-brand">
        <a href="/totem-carton-publicitaire/totem-comptoir/" class="flex items-center hover:underline">←
            Précédent : Totem de Comptoir</a>
        <a href="/totem-carton-publicitaire/totem-3-faces/" class="flex items-center hover:underline">Suivant : Totem 3 faces →</a>
    </div>
</ClusterLayout>
