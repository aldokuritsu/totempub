---
import ClusterLayout from '../../layouts/ClusterLayout.astro';
import type { BreadcrumbItem } from '../../data/navigation';

const title = 'Totem 3D & Silhouette en Carton : La PLV Spectacle | Kontfeel';
const description =
    'Donnez vie à vos produits avec le totem 3D ou la silhouette en carton personnalisée. Découpe laser à la forme de votre logo ou mascotte. Impact visuel garanti.';
const breadcrumb: BreadcrumbItem[] = [
    { name: 'Accueil', href: '/' },
    { name: 'Formes & Types', href: '/totem-carton-publicitaire/' },
    { name: 'Totem 3D / Silhouette' },
];
---

<ClusterLayout title={title} description={description} cluster="totem-carton-publicitaire" breadcrumb={breadcrumb}>
    <h1 class="text-4xl md:text-5xl font-extrabold text-brand-dark mb-6 leading-tight">Totem 3D et
        silhouette :
        brisez les codes du totem classique</h1>

    <div class="prose prose-lg prose-brand max-w-none text-gray-700">
        <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            Pourquoi se limiter à une forme géométrique simple ? Le totem silhouette et les structures 3D
            permettent de reproduire fidèlement un personnage, un produit ou un logo pour un impact
            émotionnel décuplé.
        </p>

        <div
            class="my-12 bg-gray-50 rounded-3xl p-8 flex flex-col md:flex-row gap-8 items-center border border-gray-100 shadow-inner">
            <div class="md:w-1/2">
                <h3 class="text-2xl font-bold text-brand-dark mb-4">Le pouvoir du sur-mesure</h3>
                <ul class="space-y-4">
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Réalisme bluffant</strong> : Impression haute définition associée à
                            une découpe laser précise pour une silhouette plus vraie que nature.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Effet "Whaou"</strong> : Idéal pour les lancements de produits ou les
                            films au cinéma pour inciter au partage sur les réseaux sociaux.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Modularité 3D</strong> : Assemblage de plusieurs pièces en carton pour
                            créer du relief et de la profondeur de champ.</span>
                    </li>
                </ul>
            </div>
            <div
                class="md:w-1/2 aspect-[3/4] bg-gray-200 rounded-2xl flex items-center justify-center p-12 relative overflow-hidden">
                <div class="absolute inset-0 bg-brand/5"></div>
                <svg class="w-24 h-24 text-gray-400 opacity-50 relative z-10" fill="currentColor"
                    viewBox="0 0 24 24">
                    <path
                        d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z">
                    </path>
                </svg>
            </div>
        </div>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">La silhouette, l'ambassadeur de votre marque
        </h2>
        <p class="mb-6">
            Imaginez votre mascotte ou une célébrité en taille réelle accueillant vos clients. La silhouette
            en carton est un outil de "théâtralisation" puissant. Elle humanise le point de vente et crée un
            lien immédiat avec le visiteur. C'est également un support parfait pour les "photo-booths"
            improvisés, transformant vos clients en prescripteurs sur Instagram ou Facebook.
        </p>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">Nos solutions 3D complexes</h2>
        <p class="mb-6">
            Grâce à notre savoir-faire en bureau d'études, nous concevons des meubles PLV et des totems
            complexes qui intègrent :
        </p>
        <ul class="list-disc pl-6 mb-8 space-y-2">
            <li><strong>Éclairage LED</strong> : Pour faire briller votre logo.</li>
            <li><strong>Éléments en relief</strong> : Produits géants ou accessoires en sur-épaisseur.</li>
            <li><strong>Porte-échantillons</strong> : Intégrés directement dans la structure 3D.</li>
        </ul>

        <div class="bg-brand text-white p-8 rounded-3xl mb-12 shadow-xl">
            <h4 class="text-2xl font-bold mb-4">Un projet créatif en tête ?</h4>
            <p class="mb-6 opacity-90 text-lg">Nos ingénieurs carton transforment vos idées les plus folles
                en réalité technique. Envoyez-nous un visuel, nous ferons le reste.</p>
            <a href="/contact/"
                class="inline-block bg-white text-brand px-10 py-4 rounded-full font-extrabold transition-all hover:scale-105">Parler
                à un ingénieur PLV</a>
        </div>
    </div>

    <!-- Horizontal links -->
    <div
        class="mt-16 pt-8 border-t border-gray-100 flex justify-between items-center text-sm font-bold text-brand">
        <a href="/totem-carton-publicitaire/totem-cube-carre/" class="flex items-center hover:underline">←
            Précédent : Totem Cube / Carré</a>
        <a href="/totem-carton-publicitaire/totem-comptoir/" class="flex items-center hover:underline">Suivant : Totem de Comptoir
            →</a>
    </div>
</ClusterLayout>
