---
import ClusterLayout from '../../layouts/ClusterLayout.astro';
import type { BreadcrumbItem } from '../../data/navigation';

const title = 'Totem de Comptoir en Carton : Petit Format, Grand Impact | Kontfeel';
const description =
    'Optimisez vos ventes flash avec le totem de comptoir en carton. PLV compacte pour caisse et linéaire. Facile à poser, 100% personnalisable.';
const breadcrumb: BreadcrumbItem[] = [
    { name: 'Accueil', href: '/' },
    { name: 'Formes & Types', href: '/totem-carton-publicitaire/' },
    { name: 'Totem de Comptoir' },
];
---

<ClusterLayout title={title} description={description} cluster="totem-carton-publicitaire" breadcrumb={breadcrumb}>
    <h1 class="text-4xl md:text-5xl font-extrabold text-brand-dark mb-6 leading-tight">Totem de comptoir :
        votre message à hauteur d'yeux</h1>

    <div class="prose prose-lg prose-brand max-w-none text-gray-700">
        <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            Le totem de comptoir est l'atout stratégique pour stimuler l'achat d'impulsion. Placé en caisse
            ou sur un linéaire, il capte l'attention finale du consommateur au moment crucial.
        </p>

        <div
            class="my-12 bg-gray-50 rounded-3xl p-8 flex flex-col md:flex-row gap-8 items-center border border-gray-100 shadow-inner">
            <div class="md:w-1/2">
                <h3 class="text-2xl font-bold text-brand-dark mb-4">Efficacité en format réduit</h3>
                <ul class="space-y-4">
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Proximité immédiate</strong> : Idéal pour les petits messages, les
                            offres flash ou les programmes de fidélité.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Facilité d'envoi</strong> : Peut être joint directement dans le carton
                            de livraison des produits pour un déploiement autonome par le revendeur.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-brand mt-1 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><strong>Entièrement personnalisable</strong> : Mini-totem elliptique,
                            chevalet, ou présentoir avec réceptacle.</span>
                    </li>
                </ul>
            </div>
            <div class="md:w-1/2 aspect-video bg-gray-200 rounded-2xl flex items-center justify-center p-8">
                <svg class="w-20 h-20 text-gray-400 opacity-50" fill="currentColor" viewBox="0 0 24 24">
                    <path
                        d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z">
                    </path>
                </svg>
            </div>
        </div>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">Le mini-totem, maxi impact</h2>
        <p class="mb-6">
            Ne vous fiez pas à sa petite taille. En pharmacie ou en boutique spécialisée, le totem de
            comptoir est souvent le seul support autorisé sur le comptoir d'accueil. C'est donc un
            emplacement "Premium". Nous concevons ces supports pour qu'ils soient agréables à l'œil, stables
            et qu'ils ne gênent pas l'interaction entre le vendeur et le client.
        </p>

        <h2 class="text-2xl font-bold text-brand-dark mb-6">Nos modèles populaires</h2>
        <ul class="list-disc pl-6 mb-8 space-y-2">
            <li><strong>Le Mini-Elliptique</strong> : Version réduite du totem de sol classique.</li>
            <li><strong>Le Totem L-Form</strong> : Simple face avec une base lestée ou un pied chevalet.
            </li>
            <li><strong>Le Présentoir-Totem</strong> : Combine une zone de communication et un bac pour
                flyers ou échantillons.</li>
        </ul>

        <div class="bg-gray-50 border-2 border-dashed border-gray-200 p-8 rounded-3xl mb-8 text-center">
            <p class="text-gray-500 italic mb-4">"Le saviez-vous ? 70% des achats se décident en point de
                vente, souvent au moment du passage en caisse."</p>
            <a href="/contact/" class="text-brand font-bold hover:underline">Lancez votre série de
                mini-totems →</a>
        </div>
    </div>

    <!-- Horizontal links -->
    <div
        class="mt-16 pt-8 border-t border-gray-100 flex justify-between items-center text-sm font-bold text-brand">
        <a href="/totem-carton-publicitaire/totem-3d-silhouette/" class="flex items-center hover:underline">←
            Précédent : Totem 3D / Silhouette</a>
        <a href="/totem-carton-publicitaire/totem-elliptique/" class="flex items-center hover:underline">Suivant : Totem Elliptique
            →</a>
    </div>
</ClusterLayout>
