---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ContextualMenu from '../components/ContextualMenu.astro';
import type { BreadcrumbItem, ClusterKey } from '../data/navigation';

interface Props {
    title: string;
    description: string;
    /** Silo auquel la page appartient : pilote le menu contextuel. */
    cluster: ClusterKey;
    breadcrumb: BreadcrumbItem[];
}

const { title, description, cluster, breadcrumb } = Astro.props;
---

<BaseLayout title={title} description={description}>
    <main class="container mx-auto px-4 py-12">
        <div class="flex flex-col lg:flex-row gap-12">
            <!-- Contenu -->
            <div class="lg:w-2/3">
                <Breadcrumb items={breadcrumb} />
                <slot />
            </div>

            <!-- Menu contextuel du silo -->
            <aside class="lg:w-1/3">
                <ContextualMenu cluster={cluster} />
            </aside>
        </div>
    </main>
</BaseLayout>
